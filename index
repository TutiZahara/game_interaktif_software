                options: [
                    "Freeware",
                    "Malware / Virus",
                    "Firmware",
                    "Shareware"
                ],
                answer: 1
            },
            {
                q: "Lisensi software yang memberi waktu percobaan gratis sebelum pengguna diminta membayar disebut...",
                options: [
                    "Open Source",
                    "Shareware / Trialware",
                    "Public Domain",
                    "Freeware"
                ],
                answer: 1
