                    "Microsoft Outlook",
                    "Microsoft Publisher"
                ],
                answer: 0
            },
            {
                q: "Aplikasi pengolah gambar digital berbasis komputer di antaranya adalah...",
                options: [
                    "Adobe Photoshop & GIMP",
                    "MS Word & Notepad",
                    "VLC Media Player",
                    "WinRAR"
                ],
                answer: 0
            }
        ];

        // Build the 10x10 Snake & Ladder Board
        function createBoard() {
            const boardEl = document.getElementById('board');
            boardEl.innerHTML = '';

            // Generate cells in zigzag order (1-100)
            for (let row = 9; row >= 0; row--) {
                const isEvenRow = (9 - row) % 2 === 0;
                for (let col = 0; col < 10; col++) {
                    const actualCol = isEvenRow ? col : 9 - col;
                    const cellNum = row * 10 + actualCol + 1;

                    const cell = document.createElement('div');
                    cell.id = `cell-${cellNum}`;
                    cell.className = `board-cell ${cellNum % 2 === 0 ? 'cell-even' : 'cell-odd'}`;

                    // Add markers for quiz/ladder/snake
                    if (ladders[cellNum]) {
                        cell.classList.add('cell-ladder-start');
                        cell.innerHTML = `<span>${cellNum}</span><i class="fa-solid fa-arrow-up text-emerald-600 text-xs absolute bottom-1 right-1"></i>`;
                    } else if (snakes[cellNum]) {
                        cell.classList.add('cell-snake-start');
                        cell.innerHTML = `<span>${cellNum}</span><i class="fa-solid fa-worm text-rose-600 text-xs absolute bottom-1 right-1"></i>`;
                    } else if (cellNum % 3 === 0 && cellNum < 100) {
                        cell.classList.add('cell-quiz');
                        cell.innerHTML = `<span>${cellNum}</span><i class="fa-solid fa-question text-amber-700 text-[10px] absolute bottom-1 right-1"></i>`;
                    } else {
                        cell.innerHTML = `<span>${cellNum}</span>`;
                    }

                    boardEl.appendChild(cell);
                }
            }

            // Create Player Pawn
            const pawn = document.createElement('div');
            pawn.id = 'player-pawn';
            pawn.className = 'player-pawn absolute w-6 h-6 rounded-full bg-gradient-to-tr from-indigo-500 to-pink-500 border-2 border-white shadow-lg flex items-center justify-center text-[10px] text-white font-bold';
            pawn.innerHTML = '<i class="fa-solid fa-user"></i>';
            boardEl.appendChild(pawn);

            updatePawnPosition(1);
        }

        // Draw connections (ladders & snakes) overlay
        function drawOverlayConnections() {
            const svg = document.getElementById('board-svg');
            svg.innerHTML = '';

            const boardRect = document.getElementById('board').getBoundingClientRect();
            if (boardRect.width === 0) return;

            // Helper to get relative cell centers
            const getCellCenter = (num) => {
                const cell = document.getElementById(`cell-${num}`);
                const rect = cell.getBoundingClientRect();
                return {
                    x: rect.left - boardRect.left + rect.width / 2,
                    y: rect.top - boardRect.top + rect.height / 2
                };
            };

            // Draw Ladders (Green Lines)
            for (let [start, end] of Object.entries(ladders)) {
                const p1 = getCellCenter(start);
                const p2 = getCellCenter(end);
                const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                line.setAttribute('x1', p1.x);
                line.setAttribute('y1', p1.y);
                line.setAttribute('x2', p2.x);
                line.setAttribute('y2', p2.y);
                line.setAttribute('stroke', '#10b981');
                line.setAttribute('stroke-width', '5');
                line.setAttribute('stroke-dasharray', '6 3');
                line.setAttribute('stroke-linecap', 'round');
                line.setAttribute('opacity', '0.85');
                svg.appendChild(line);
            }

            // Draw Snakes (Red Lines)
            for (let [start, end] of Object.entries(snakes)) {
                const p1 = getCellCenter(start);
                const p2 = getCellCenter(end);
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                const midX = (p1.x + p2.x) / 2 + 20;
                const midY = (p1.y + p2.y) / 2 - 20;
                path.setAttribute('d', `M ${p1.x} ${p1.y} Q ${midX} ${midY} ${p2.x} ${p2.y}`);
                path.setAttribute('stroke', '#f43f5e');
                path.setAttribute('stroke-width', '5');
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('opacity', '0.85');
                svg.appendChild(path);
            }
        }

        // Move pawn on board visually
        function updatePawnPosition(pos) {
            currentPos = pos;
            const cell = document.getElementById(`cell-${pos}`);
            const pawn = document.getElementById('player-pawn');
            if (cell && pawn) {
                pawn.style.top = `${cell.offsetTop + cell.offsetHeight / 2 - 12}px`;
                pawn.style.left = `${cell.offsetLeft + cell.offsetWidth / 2 - 12}px`;
            }
            document.getElementById('display-pos').innerText = `Petak ${pos}`;
        }

        // Start Game Handler
        function startGame(e) {
            e.preventDefault();
            studentName = document.getElementById('student-name').value.trim();
            studentClass = document.getElementById('student-class').value.trim();

            if (!studentName || !studentClass) return;

            document.getElementById('display-name').innerText = studentName;
            document.getElementById('display-class').innerText = `Kelas ${studentClass}`;

            document.getElementById('login-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');

            createBoard();
            setTimeout(drawOverlayConnections, 200);
            window.addEventListener('resize', drawOverlayConnections);
        }

        // Roll Dice Handler
        function rollDice() {
            if (isRolling) return;
            isRolling = true;
            document.getElementById('roll-btn').disabled = true;

            const dice = document.getElementById('dice');
            const statusText = document.getElementById('game-status-text');
            statusText.innerText = "Mengocok dadu...";

            const diceVal = Math.floor(Math.random() * 6) + 1;

            // 3D rotation map
            const rotations = {
                1: 'rotateX(0deg) rotateY(0deg)',
                2: 'rotateY(-180deg)',
                3: 'rotateY(-90deg)',
                4: 'rotateY(90deg)',
                5: 'rotateX(-90deg)',
                6: 'rotateX(90deg)'
            };

            // Add extra spins for animation
            dice.style.transform = `rotateX(${720 + Math.random()*360}deg) rotateY(${720 + Math.random()*360}deg)`;

            setTimeout(() => {
                dice.style.transform = rotations[diceVal];
                statusText.innerText = `Dadu menghasilkan angka ${diceVal}!`;

                setTimeout(() => {
                    movePlayer(diceVal);
                }, 800);
            }, 600);
        }

        // Move player stepwise
        function movePlayer(steps) {
            let targetPos = currentPos + steps;
            if (targetPos > 100) {
                targetPos = 100 - (targetPos - 100); // Bounce back if exceeding 100
            }

            let stepCount = 0;
            const interval = setInterval(() => {
                if (currentPos < targetPos) currentPos++;
                else if (currentPos > targetPos) currentPos--;

                updatePawnPosition(currentPos);
                stepCount++;

                if (currentPos === targetPos) {
                    clearInterval(interval);
                    setTimeout(() => evaluatePosition(), 400);
                }
            }, 250);
        }

        // Evaluate special tile landing
        function evaluatePosition() {
            const statusText = document.getElementById('game-status-text');

            // 1. Check if landed on Ladder
            if (ladders[currentPos]) {
                const destination = ladders[currentPos];
                statusText.innerText = "Narik TANGGA! Jawab kuis untuk NAIK!";
                triggerQuiz({ type: 'LADDER', from: currentPos, to: destination });
                return;
            }

            // 2. Check if landed on Snake
            if (snakes[currentPos]) {
                const destination = snakes[currentPos];
                statusText.innerText = "Kena ULAR! Jawab kuis untuk SELAMAT!";
                triggerQuiz({ type: 'SNAKE', from: currentPos, to: destination });
                return;
            }

            // 3. Regular Quiz Tile (Every 3 tiles or landing tile)
            if (currentPos % 3 === 0 && currentPos < 100) {
                statusText.innerText = "Petak Kuis Informatik!";
                triggerQuiz({ type: 'REGULAR', pos: currentPos });
                return;
            }

            // Check Victory
            if (currentPos === 100) {
                handleVictory();
            } else {
                isRolling = false;
                document.getElementById('roll-btn').disabled = false;
                statusText.innerText = "Giliranmu berikutnya. Kocok dadu!";
            }
        }

        // Trigger Quiz Modal
        function triggerQuiz(context) {
            pendingMoveContext = context;
            selectedOption = null;

            // Pick random question from bank
            const qObj = questionBank[Math.floor(Math.random() * questionBank.length)];
            
            document.getElementById('quiz-question').innerText = qObj.q;
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            const feedback = document.getElementById('quiz-feedback');
            feedback.classList.add('hidden');

            qObj.options.forEach((optText, index) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-3 rounded-xl border border-slate-700 bg-slate-900/80 hover:bg-slate-700/80 text-xs md:text-sm text-slate-200 transition flex items-center gap-3';
                btn.innerHTML = `<span class="w-6 h-6 rounded-full bg-slate-800 border border-slate-600 flex items-center justify-center font-bold text-xs text-indigo-400">${String.fromCharCode(65 + index)}</span> <span>${optText}</span>`;
                
                btn.onclick = () => {
                    Array.from(optionsContainer.children).forEach(c => c.classList.remove('border-indigo-500', 'bg-indigo-600/20'));
                    btn.classList.add('border-indigo-500', 'bg-indigo-600/20');
                    selectedOption = index;
                    document.getElementById('quiz-submit-btn').disabled = false;
                };

                optionsContainer.appendChild(btn);
            });

            // Store active question reference
            document.getElementById('quiz-modal').dataset.correct = qObj.answer;
            document.getElementById('quiz-modal').classList.remove('hidden');
            document.getElementById('quiz-submit-btn').disabled = true;
        }

        // Submit Quiz Answer
        function submitAnswer() {
            if (selectedOption === null) return;

            const modal = document.getElementById('quiz-modal');
            const correctAns = parseInt(modal.dataset.correct);
            const feedback = document.getElementById('quiz-feedback');
            const submitBtn = document.getElementById('quiz-submit-btn');

            submitBtn.disabled = true;

            const isCorrect = (selectedOption === correctAns);

            feedback.classList.remove('hidden', 'bg-emerald-500/20', 'text-emerald-300', 'bg-rose-500/20', 'text-rose-300');
            
            if (isCorrect) {
                correctCount++;
                score += 20;
                feedback.classList.add('bg-emerald-500/20', 'text-emerald-300');
                feedback.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i> BENAR! (+20 Skor)';
            } else {
                wrongCount++;
                score = Math.max(0, score - 5);
                feedback.classList.add('bg-rose-500/20', 'text-rose-300');
                feedback.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> SALAH! (-5 Skor)';
            }

            // Update stats
            document.getElementById('display-score').innerText = score;
            document.getElementById('display-correct').innerText = correctCount;
            document.getElementById('display-wrong').innerText = wrongCount;

            // Resolve game context movement
            setTimeout(() => {
                modal.classList.add('hidden');
                resolveMoveContext(isCorrect);
            }, 1200);
        }

        // Resolve Snake/Ladder/Bonus based on quiz answer
        function resolveMoveContext(isCorrect) {
            const ctx = pendingMoveContext;
            const statusText = document.getElementById('game-status-text');

            if (!ctx) return;

            if (ctx.type === 'LADDER') {
                if (isCorrect) {
                    statusText.innerText = `Jawaban Benar! Kamu NAIK ke petak ${ctx.to}!`;
                    updatePawnPosition(ctx.to);
                } else {
                    statusText.innerText = "Jawaban Salah! Gagal naik tangga.";
                }
            } else if (ctx.type === 'SNAKE') {
                if (isCorrect) {
                    statusText.innerText = "Jawaban Benar! Kamu SELAMAT dari patukan ular!";
                } else {
                    statusText.innerText = `Jawaban Salah! Kamu TURUN ke petak ${ctx.to}!`;
                    updatePawnPosition(ctx.to);
                }
            } else if (ctx.type === 'REGULAR') {
                if (isCorrect) {
                    statusText.innerText = "Bonus Jawaban Benar! Maju 1 langkah ekstra!";
                    setTimeout(() => updatePawnPosition(Math.min(100, currentPos + 1)), 400);
                } else {
                    statusText.innerText = "Jawaban Salah! Tetap di posisi saat ini.";
                }
            }

            if (currentPos === 100) {
                handleVictory();
            } else {
                isRolling = false;
                document.getElementById('roll-btn').disabled = false;
            }
        }

        // Handle Game Victory
        function handleVictory() {
            // Trigger Confetti
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 }
            });

            // Populate Certificate Data
            document.getElementById('cert-name').innerText = studentName;
            document.getElementById('cert-class').innerText = `Kelas ${studentClass}`;
            document.getElementById('cert-score').innerText = score;
            document.getElementById('cert-correct').innerText = correctCount;
            document.getElementById('cert-wrong').innerText = wrongCount;
            
            const now = new Date();
            document.getElementById('cert-date').innerText = `${now.getDate()}/${now.getMonth()+1}/${now.getFullYear()}`;

            document.getElementById('victory-modal').classList.remove('hidden');
        }

        // Restart Game
        function restartGame() {
            currentPos = 1;
            score = 0;
            correctCount = 0;
            wrongCount = 0;
            isRolling = false;

            document.getElementById('display-score').innerText = '0';
            document.getElementById('display-correct').innerText = '0';
            document.getElementById('display-wrong').innerText = '0';
            document.getElementById('game-status-text').innerText = 'Game telah direset. Silakan kocok dadu!';

            document.getElementById('victory-modal').classList.add('hidden');
            updatePawnPosition(1);
            document.getElementById('roll-btn').disabled = false;
        }
    </script>
</body>
